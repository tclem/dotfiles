#!/bin/bash
#
# Sync private config from tclem/config into ~/.config/ via symlinks.
#
#   script/sync-config install   — clone/pull tclem/config, symlink files into ~/.config
#   script/sync-config import P  — move ~/.config/P into the repo at the matching path, symlink back
#
# Layout convention: tclem/config mirrors ~/.config/. A file at
# <repo>/<app>/<file> is symlinked to ~/.config/<app>/<file>. Only tracked files
# are linked, and a differing pre-existing file is kept rather than overwritten.
# A tracked executable root install.sh is setup metadata: it is run after sync,
# never linked, and must be safe to run repeatedly.

set -euo pipefail

CONFIG_REPO_SLUG="tclem/config"
CONFIG_REPO_DIR="$HOME/github/config"
TARGET_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}"

green()  { printf "\033[32m%s\033[0m\n" "$1"; }
yellow() { printf "\033[33m%s\033[0m\n" "$1"; }
red()    { printf "\033[31m%s\033[0m\n" "$1"; }

ensure_clone() {
  if [ -d "$CONFIG_REPO_DIR/.git" ]; then
    (cd "$CONFIG_REPO_DIR" && git pull --quiet --ff-only) \
      || yellow "warn: could not fast-forward $CONFIG_REPO_DIR; leaving as-is"
  else
    mkdir -p "$(dirname "$CONFIG_REPO_DIR")"
    green "cloning $CONFIG_REPO_SLUG → $CONFIG_REPO_DIR"
    gh repo clone "$CONFIG_REPO_SLUG" "$CONFIG_REPO_DIR" -- --quiet
  fi
}

# Paths that diverged from the repo copy and were left alone. Reported at the end.
CONFLICTS=()

# Replaces a pre-existing real file only when content already matches. When it
# differs, neither side is knowably authoritative, so keep it and report.
link_one() {
  local src="$1" rel="$2"
  local dest="$TARGET_ROOT/$rel"
  mkdir -p "$(dirname "$dest")"

  if [ -L "$dest" ]; then
    local current
    current="$(readlink "$dest")"
    if [ "$current" = "$src" ]; then
      return 0
    fi
    yellow "replacing symlink $dest (was → $current)"
    rm "$dest"
  elif [ -e "$dest" ]; then
    if ! cmp -s "$dest" "$src"; then
      CONFLICTS+=("$rel")
      red "kept $rel (differs from repo copy)"
      return 0
    fi
    rm "$dest"
  fi

  ln -s "$src" "$dest"
  green "linked $rel"
}

report_conflicts() {
  [ ${#CONFLICTS[@]} -eq 0 ] && return 0

  echo
  red "${#CONFLICTS[@]} file(s) differ from $CONFIG_REPO_SLUG and were left alone:"
  for rel in "${CONFLICTS[@]}"; do
    echo "  $rel"
  done
  echo "Resolve with: diff \$HOME/.config/<rel> $CONFIG_REPO_DIR/<rel>"
  echo "Then copy the winner into the other side and re-run."
}

cmd_install() {
  ensure_clone

  # Tracked files only: a directory walk also links .DS_Store and ignored state.
  while IFS= read -r -d '' rel; do
    case "$rel" in
      .github/*|.gitignore|README.md|LICENSE|install.sh) continue ;;
    esac
    local src="$CONFIG_REPO_DIR/$rel"
    [ -f "$src" ] || continue
    link_one "$src" "$rel"
  done < <(git -C "$CONFIG_REPO_DIR" ls-files -z)

  report_conflicts

  local install_hook="$CONFIG_REPO_DIR/install.sh"
  if [ -e "$install_hook" ]; then
    if [ ! -x "$install_hook" ]; then
      red "$install_hook is not executable"
      return 1
    fi
    green "running private config install hook"
    "$install_hook"
  fi
}

cmd_import() {
  local rel="${1:?usage: sync-config import <relative-path-under-.config>}"
  ensure_clone

  local src="$TARGET_ROOT/$rel"
  local dest="$CONFIG_REPO_DIR/$rel"

  if [ ! -e "$src" ]; then
    red "no file at $src"; exit 1
  fi
  if [ -L "$src" ]; then
    red "$src is already a symlink; nothing to import"; exit 1
  fi
  if [ -e "$dest" ]; then
    red "$dest already exists in repo; resolve manually"; exit 1
  fi

  mkdir -p "$(dirname "$dest")"
  mv "$src" "$dest"
  ln -s "$dest" "$src"
  green "imported $rel into $CONFIG_REPO_SLUG"
  green "next: cd $CONFIG_REPO_DIR && git add -A && git commit && git push"
}

case "${1:-install}" in
  install) cmd_install ;;
  import)  shift; cmd_import "$@" ;;
  *) red "usage: sync-config {install|import <rel-path>}"; exit 1 ;;
esac
