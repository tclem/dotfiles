#!/bin/bash
#
# Sync private config from tclem/config into ~/.config/ via symlinks.
#
#   script/sync-config install   — clone/pull tclem/config, symlink files into ~/.config
#   script/sync-config import P  — move ~/.config/P into the repo at the matching path, symlink back
#
# Layout convention: tclem/config mirrors ~/.config/. A file at
# <repo>/<app>/<file> is symlinked to ~/.config/<app>/<file>. Only git-tracked
# files are linked, so the repo's .gitignore decides what counts as config.
# A pre-existing real file is never overwritten: it is replaced only when its
# content already matches, and otherwise left in place and reported.

set -euo pipefail

CONFIG_REPO_SLUG="tclem/config"
CONFIG_REPO_DIR="$HOME/github/config"
TARGET_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}"

green()  { printf "\033[32m%s\033[0m\n" "$1"; }
yellow() { printf "\033[33m%s\033[0m\n" "$1"; }
red()    { printf "\033[31m%s\033[0m\n" "$1"; }

ensure_clone() {
  if [ -d "$CONFIG_REPO_DIR/.git" ]; then
    (cd "$CONFIG_REPO_DIR" && git pull --quiet --ff-only) \
      || yellow "warn: could not fast-forward $CONFIG_REPO_DIR; leaving as-is"
  else
    mkdir -p "$(dirname "$CONFIG_REPO_DIR")"
    green "cloning $CONFIG_REPO_SLUG → $CONFIG_REPO_DIR"
    gh repo clone "$CONFIG_REPO_SLUG" "$CONFIG_REPO_DIR" -- --quiet
  fi
}

# Paths that diverged from the repo copy and were left alone. Reported at the end.
CONFLICTS=()

# Symlink one repo file into ~/.config.
#
# A pre-existing real file is only replaced when its content already matches the
# repo copy, where linking loses nothing. When it differs we cannot tell which
# side is authoritative -- the live file may be months of edits the repo never
# saw -- so it stays put and gets reported.
link_one() {
  local src="$1" rel="$2"
  local dest="$TARGET_ROOT/$rel"
  mkdir -p "$(dirname "$dest")"

  if [ -L "$dest" ]; then
    local current
    current="$(readlink "$dest")"
    if [ "$current" = "$src" ]; then
      return 0
    fi
    yellow "replacing symlink $dest (was → $current)"
    rm "$dest"
  elif [ -e "$dest" ]; then
    if ! cmp -s "$dest" "$src"; then
      CONFLICTS+=("$rel")
      red "kept $rel (differs from repo copy)"
      return 0
    fi
    rm "$dest"
  fi

  ln -s "$src" "$dest"
  green "linked $rel"
}

report_conflicts() {
  [ ${#CONFLICTS[@]} -eq 0 ] && return 0

  echo
  red "─── ${#CONFLICTS[@]} file(s) not linked ───"
  echo "These exist in ~/.config with content that differs from $CONFIG_REPO_SLUG."
  echo "Nothing was overwritten. Pick a side for each:"
  echo
  for rel in "${CONFLICTS[@]}"; do
    echo "  $rel"
    echo "    diff \"$TARGET_ROOT/$rel\" \"$CONFIG_REPO_DIR/$rel\""
  done
  echo
  echo "Live file wins:  cp \"$TARGET_ROOT/<rel>\" \"$CONFIG_REPO_DIR/<rel>\"  then commit, and re-run"
  echo "Repo file wins:  rm \"$TARGET_ROOT/<rel>\"                            then re-run"
}

cmd_install() {
  ensure_clone

  # Tracked files only, so the repo's .gitignore decides what counts as config.
  # A plain directory walk sweeps up .DS_Store, editor droppings, and ignored
  # runtime state, then symlinks them into ~/.config as though they were config.
  while IFS= read -r -d '' rel; do
    case "$rel" in
      .github/*|.gitignore|README.md|LICENSE) continue ;;
    esac
    local src="$CONFIG_REPO_DIR/$rel"
    [ -f "$src" ] || continue
    link_one "$src" "$rel"
  done < <(git -C "$CONFIG_REPO_DIR" ls-files -z)

  report_conflicts
}

cmd_import() {
  local rel="${1:?usage: sync-config import <relative-path-under-.config>}"
  ensure_clone

  local src="$TARGET_ROOT/$rel"
  local dest="$CONFIG_REPO_DIR/$rel"

  if [ ! -e "$src" ]; then
    red "no file at $src"; exit 1
  fi
  if [ -L "$src" ]; then
    red "$src is already a symlink; nothing to import"; exit 1
  fi
  if [ -e "$dest" ]; then
    red "$dest already exists in repo; resolve manually"; exit 1
  fi

  mkdir -p "$(dirname "$dest")"
  mv "$src" "$dest"
  ln -s "$dest" "$src"
  green "imported $rel into $CONFIG_REPO_SLUG"
  green "next: cd $CONFIG_REPO_DIR && git add -A && git commit && git push"
}

case "${1:-install}" in
  install) cmd_install ;;
  import)  shift; cmd_import "$@" ;;
  *) red "usage: sync-config {install|import <rel-path>}"; exit 1 ;;
esac
