#!/bin/bash
#
# Sync portable copilot config between this repo and ~/.copilot.
#
#   script/sync-copilot install   — symlink repo files into ~/.copilot
#   script/sync-copilot import    — copy new files from ~/.copilot into the repo, then symlink

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
COPILOT_HOME="$HOME/.copilot"
COPILOT_REPO="$DOTFILES_ROOT/copilot"

# Portable paths (relative to copilot root) that we sync.
# Globs are expanded against the source directory for each direction.
PORTABLE_GLOBS=(
  "copilot-instructions.md"
  "agents/*.agent.md"
  "skills/*/SKILL.md"
  "docs/*"
)

# Extensions are symlinked at the directory level rather than per-file: an
# extension is an opaque tree (extension.mjs + arbitrary lib/web/assets), and
# enumerating every nested file would be brittle.
EXTENSIONS_DIR_NAME="extensions"

# External extensions are cloned from GitHub instead of living in this repo.
# Each entry in $EXTERNAL_EXTENSIONS_FILE is `owner/repo[@ref] [subpath] [install-name]`.
# Clones live in $EXT_CACHE_ROOT and are linked into ~/.copilot/extensions/<install-name>/
# the same way as repo-local extensions.
EXTERNAL_EXTENSIONS_FILE="${EXTERNAL_EXTENSIONS_FILE:-$COPILOT_REPO/external-extensions}"
EXT_CACHE_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/copilot-external-extensions"
EXT_MATERIALIZED_ROOT="$EXT_CACHE_ROOT/.materialized"
EXT_LOCK_ROOT="$EXT_CACHE_ROOT/.sync-lock"
EXT_LOCK_TIMEOUT_SECONDS="${COPILOT_EXTERNAL_EXTENSIONS_LOCK_TIMEOUT_SECONDS:-30}"
EXT_LOCK_TICKET=""
EXT_LOCK_CHOOSING=""
EXT_LOCK_TOKEN=""

# Skills that live outside this repo — personal ones kept in a private repo
# rather than published here. Each line of $EXTERNAL_SKILLS_FILE is a path to a
# directory of `<name>/SKILL.md`. Only the path lives in this public repo; the
# skills themselves stay wherever they are.
EXTERNAL_SKILLS_FILE="$COPILOT_REPO/external-skills"
PROJECTS_ROOT="${PROJECTS:-$HOME/github}"

green()  { printf "\033[32m%s\033[0m\n" "$1"; }
yellow() { printf "\033[33m%s\033[0m\n" "$1"; }

# Return 0 if the SKILL.md at $1 has `disabled: true` in its frontmatter, else 1.
# Frontmatter is the leading `---`-delimited YAML block. Anything outside is ignored.
is_disabled_skill() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  awk '
    NR==1 && /^---[[:space:]]*$/ { in_fm=1; next }
    in_fm && /^---[[:space:]]*$/ { exit }
    in_fm && /^disabled:[[:space:]]*true[[:space:]]*$/ { found=1; exit }
    END { exit !found }
  ' "$file"
}

# Expand globs against a root directory, returning paths relative to that root.
expand_globs() {
  local root="$1"
  shift
  local results=()
  for glob in "$@"; do
    # Use find-like expansion via bash globbing
    for f in "$root"/$glob; do
      [[ -f "$f" || -L "$f" ]] && results+=("${f#$root/}")
    done
  done
  printf '%s\n' "${results[@]}"
}

# Resolve symlinks in the full path. `realpath` is present on macOS 12.3+ and
# GNU coreutils; the manual walk covers older BSD systems that have neither it
# nor `readlink -f`.
resolve_path() {
  local p="$1"
  if command -v realpath >/dev/null 2>&1; then
    realpath "$p" 2>/dev/null && return
  fi
  local dir base
  dir="$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)" || return
  base="$(basename "$p")"
  while [[ -L "$dir/$base" ]]; do
    local target
    target="$(readlink "$dir/$base")"
    if [[ "$target" == /* ]]; then
      dir="$(cd "$(dirname "$target")" 2>/dev/null && pwd -P)"
    else
      dir="$(cd "$dir/$(dirname "$target")" 2>/dev/null && pwd -P)"
    fi
    base="$(basename "$target")"
  done
  printf '%s/%s\n' "$dir" "$base"
}

prune_removed_links() {
  local files="$1"
  local installed
  installed=$(expand_globs "$COPILOT_HOME" "${PORTABLE_GLOBS[@]}")

  while IFS= read -r rel; do
    [[ -z "$rel" ]] && continue
    grep -qxF "$rel" <<< "$files" && continue

    local dst="$COPILOT_HOME/$rel"
    [[ -L "$dst" ]] || continue

    local target
    target=$(readlink "$dst")
    if [[ "$target" == "$COPILOT_REPO/"* ]]; then
      rm "$dst"
      rmdir -p "$(dirname "$dst")" 2>/dev/null || true
      yellow "  removed $rel"
    fi
  done <<< "$installed"
}

# Link `<name>/SKILL.md` from each root listed in $EXTERNAL_SKILLS_FILE into
# ~/.copilot/skills/<name>/. Roots are plain paths, not clones — they point at
# repos already checked out locally. A missing root warns rather than failing:
# a machine without that checkout should still get a working install.
install_external_skills() {
  [[ -f "$EXTERNAL_SKILLS_FILE" ]] || return 0

  local dst_root="$COPILOT_HOME/skills"
  local linked=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="$(printf '%s' "$line" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
    [[ -z "$line" ]] && continue

    local root="${line/#\$PROJECTS/$PROJECTS_ROOT}"
    root="${root/#\~/$HOME}"
    if [[ ! -d "$root" ]]; then
      yellow "  skip external skills: $line (not checked out)"
      continue
    fi

    local skill
    for skill in "$root"/*/SKILL.md; do
      [[ -f "$skill" ]] || continue
      if is_disabled_skill "$skill"; then
        yellow "  skip $(basename "$(dirname "$skill")") (disabled: true)"
        continue
      fi
      local name dst
      name="$(basename "$(dirname "$skill")")"
      dst="$dst_root/$name/SKILL.md"
      if [[ -e "$dst" && ! -L "$dst" ]]; then
        yellow "  skip $name (real file at $dst, not replacing)"
        continue
      fi
      mkdir -p "$(dirname "$dst")"
      ln -sfn "$skill" "$dst"
      green "  linked skills/$name/SKILL.md → $root/$name"
      linked=$((linked + 1))
    done
  done < "$EXTERNAL_SKILLS_FILE"

  (( linked > 0 )) && echo "External skills: $linked linked"
  return 0
}

configure_blackbird() {
  command -v gh >/dev/null 2>&1 || return 0
  if ! gh blackbird skills install --help >/dev/null 2>&1; then
    yellow "  skip Blackbird configuration (gh blackbird not installed)"
    return 0
  fi

  DOTFILES_ROOT="$DOTFILES_ROOT" COPILOT_HOME="$COPILOT_HOME" \
    bash "$DOTFILES_ROOT/script/configure-blackbird" remote-only
}

cmd_install() {
  echo "Installing copilot config: $COPILOT_REPO → $COPILOT_HOME"
  local files filtered=() skipped=()
  files=$(expand_globs "$COPILOT_REPO" "${PORTABLE_GLOBS[@]}")

  while IFS= read -r rel; do
    [[ -z "$rel" ]] && continue
    local src="$COPILOT_REPO/$rel"

    if [[ "$rel" == skills/*/SKILL.md ]] && is_disabled_skill "$src"; then
      skipped+=("$rel")
      continue
    fi

    filtered+=("$rel")
    local dst="$COPILOT_HOME/$rel"
    mkdir -p "$(dirname "$dst")"
    ln -sf "$src" "$dst"
    green "  linked $rel"
  done <<< "$files"

  local filtered_list
  filtered_list=$(printf '%s\n' "${filtered[@]}")
  prune_removed_links "$filtered_list"

  install_extensions
  install_external_extensions
  install_external_skills
  configure_blackbird

  if (( ${#skipped[@]} > 0 )); then
    echo
    yellow "Skipped (disabled: true):"
    for rel in "${skipped[@]}"; do
      yellow "  $rel"
    done
  fi
}

# Symlink every top-level entry of <src> into <dst> (a real directory).
# Prunes stale links inside <dst> whose target starts with <safe-prefix>.
# Emits a green "linked ..." line tagged with <label>.
_link_tree_into_extensions_dir() {
  local src="$1" dst="$2" safe_prefix="$3" label="$4"

  if [[ -L "$dst" ]]; then
    rm "$dst"
  elif [[ -e "$dst" && ! -d "$dst" ]]; then
    yellow "  skip $label (exists, not a directory)"
    return 0
  fi
  mkdir -p "$dst"

  local seen_entries=()
  for entry in "$src"/* "$src"/.[!.]*; do
    [[ -e "$entry" ]] || continue
    local base
    base=$(basename "$entry")
    case "$base" in
      .git|.github|.gitignore|.gitattributes|node_modules) continue ;;
    esac
    seen_entries+=("$base")
    if [[ -L "$dst/$base" ]] || readlink "$dst/$base" >/dev/null 2>&1; then
      rm "$dst/$base"
    fi
    ln -s "$entry" "$dst/$base"
  done

  for entry in "$dst"/* "$dst"/.[!.]*; do
    [[ -L "$entry" ]] || continue
    local base
    base=$(basename "$entry")
    local keep=0
    for s in "${seen_entries[@]}"; do
      [[ "$s" == "$base" ]] && { keep=1; break; }
    done
    if (( !keep )); then
      local target
      target=$(readlink "$entry")
      if [[ "$target" == "$safe_prefix"* ]]; then
        rm "$entry"
        yellow "  removed $label/$base"
      fi
    fi
  done

  green "  linked $label (${#seen_entries[@]} entries)"
}

# Remove dirs in $dst_root that are entirely composed of symlinks pointing into
# $safe_prefix and whose name is not in the newline-delimited $keep_list.
_prune_managed_extension_dirs() {
  local dst_root="$1" safe_prefix="$2" keep_list="$3" label_prefix="$4"
  for existing in "$dst_root"/*; do
    [[ -d "$existing" && ! -L "$existing" ]] || continue
    local name
    name=$(basename "$existing")
    grep -qxF "$name" <<< "$keep_list" && continue

    local safe=1
    for entry in "$existing"/* "$existing"/.[!.]*; do
      [[ -e "$entry" ]] || continue
      if [[ ! -L "$entry" ]] || [[ "$(readlink "$entry")" != "$safe_prefix"* ]]; then
        safe=0
        break
      fi
    done
    if (( safe )); then
      rm -rf "$existing"
      yellow "  removed $label_prefix/$name"
    fi
  done
}

# Make $COPILOT_HOME/extensions/<name>/ a *real* directory (because the CLI
# discovery does not follow symlinks at the extension-directory level) with
# every entry inside symlinked back to the source tree. Top-level files
# (extension.mjs) and subdirectories (lib/, web/, assets/) are both linked —
# Node follows symlinks when resolving imports, so nested links are fine.
install_extensions() {
  local src_root="$COPILOT_REPO/$EXTENSIONS_DIR_NAME"
  local dst_root="$COPILOT_HOME/$EXTENSIONS_DIR_NAME"
  [[ -d "$src_root" ]] || return 0
  mkdir -p "$dst_root"

  local kept=()
  for src in "$src_root"/*/; do
    [[ -d "$src" ]] || continue
    src="${src%/}"
    local name
    name=$(basename "$src")
    kept+=("$name")
    _link_tree_into_extensions_dir "$src" "$dst_root/$name" "$COPILOT_REPO/" "extensions/$name"
  done

  local keep_list=""
  if (( ${#kept[@]} > 0 )); then
    keep_list=$(printf '%s\n' "${kept[@]}")
  fi
  _prune_managed_extension_dirs "$dst_root" "$COPILOT_REPO/" "$keep_list" "extensions"
}

_resolve_external_commit() {
  local clone_dir="$1" ref="$2"

  if [[ -z "$ref" ]]; then
    local default_branch
    default_branch=$(git -C "$clone_dir" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')
    [[ -z "$default_branch" ]] && default_branch=main
    git -C "$clone_dir" rev-parse --verify "refs/remotes/origin/$default_branch^{commit}"
    return
  fi

  if git -C "$clone_dir" show-ref --verify --quiet "refs/remotes/origin/$ref"; then
    git -C "$clone_dir" rev-parse --verify "refs/remotes/origin/$ref^{commit}"
  elif git -C "$clone_dir" rev-parse --verify "$ref^{commit}" >/dev/null 2>&1; then
    git -C "$clone_dir" rev-parse --verify "$ref^{commit}"
  else
    git -C "$clone_dir" fetch --quiet origin "$ref" &&
      git -C "$clone_dir" rev-parse --verify "FETCH_HEAD^{commit}"
  fi
}

_ensure_cache_directory() {
  local path="$1" root="$2"
  if [[ -e "$path" || -L "$path" ]]; then
    [[ -d "$path" ]] || return 1
  else
    mkdir "$path" 2>/dev/null || [[ -d "$path" ]] || return 1
  fi

  local resolved_path resolved_root
  resolved_path=$(cd "$path" && pwd -P) || return 1
  resolved_root=$(cd "$root" && pwd -P) || return 1
  case "$resolved_path/" in
    "$resolved_root/"*) ;;
    *) return 1 ;;
  esac
}

_external_lock_process_identity() {
  local platform pid started
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
      platform=windows
      pid=$(cat "/proc/$$/winpid" 2>/dev/null) || return 1
      local pwsh
      pwsh=$(command -v pwsh.exe 2>/dev/null || command -v powershell.exe 2>/dev/null) || return 1
      started=$(
        "$pwsh" -NoLogo -NoProfile -Command \
          "\$p = Get-Process -Id $pid -ErrorAction SilentlyContinue; if (\$null -eq \$p) { exit 1 }; [Console]::Write(\$p.StartTime.ToUniversalTime().Ticks)"
      ) || return 1
      ;;
    *)
      platform=unix
      pid=$$
      started=$(LC_ALL=C ps -p "$pid" -o lstart= 2>/dev/null | tr -cd '[:alnum:]') || return 1
      ;;
  esac
  [[ "$pid" =~ ^[0-9]+$ && -n "$started" ]] || return 1
  printf '%s\n%s\n%s\n' "$platform" "$pid" "$started"
}

_external_lock_owner_is_live() {
  local platform="$1" pid="$2" started="$3"
  [[ "${COPILOT_EXTERNAL_EXTENSIONS_TEST_OWNER_STATUS:-}" != unknown ]] || return 2
  if [[ "$platform" == windows ]]; then
    local pwsh current
    pwsh=$(command -v pwsh.exe 2>/dev/null || command -v powershell.exe 2>/dev/null) || return 2
    current=$(
      "$pwsh" -NoLogo -NoProfile -Command \
        "\$p = Get-Process -Id $pid -ErrorAction SilentlyContinue; if (\$null -eq \$p) { exit 3 }; try { [Console]::Write(\$p.StartTime.ToUniversalTime().Ticks) } catch { exit 4 }"
    )
    local status=$?
    if (( status == 0 )); then
      [[ "$current" == "$started" ]]
      return
    fi
    (( status == 3 )) && return 1
    return 2
  fi

  [[ "$platform" == unix ]] || return 2
  local current status
  current=$(LC_ALL=C ps -p "$pid" -o lstart= 2>/dev/null | tr -cd '[:alnum:]')
  status=$?
  if (( status == 0 )) && [[ -n "$current" ]]; then
    [[ "$current" == "$started" ]]
    return
  fi
  if LC_ALL=C ps -p "$pid" >/dev/null 2>&1; then
    return 2
  fi
  status=$?
  (( status == 1 )) && return 1
  return 2
}

_external_lock_candidate_identity() {
  local name="$1"
  if [[ "$name" =~ ^choosing--(windows|unix)--([0-9]+)--([A-Za-z0-9]+)--([0-9a-f]+)$ ]]; then
    printf '%s\n%s\n%s\n%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
    return
  fi
  if [[ "$name" =~ ^ticket-[0-9]{10}--(windows|unix)--([0-9]+)--([A-Za-z0-9]+)--([0-9a-f]+)$ ]]; then
    printf '%s\n%s\n%s\n%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
    return
  fi
  return 1
}

_remove_external_lock_candidate_if_stale() {
  local candidate="$1"
  local name identity=()
  name=$(basename "$candidate")
  while IFS= read -r value; do identity+=("$value"); done < <(_external_lock_candidate_identity "$name") || return 0
  (( ${#identity[@]} == 4 )) || return 0
  [[ "${identity[3]}" != "$EXT_LOCK_TOKEN" ]] || return 0
  if _external_lock_owner_is_live "${identity[0]}" "${identity[1]}" "${identity[2]}"; then
    return 0
  else
    local owner_status=$?
    (( owner_status == 1 )) || return 0
  fi

  local owner_file="$candidate/owner"
  if [[ -f "$owner_file" ]]; then
    local entries
    entries=$(find "$candidate" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d '[:space:]')
    [[ "$entries" == 1 ]] || return 0
    rm "$owner_file" 2>/dev/null || return 0
  else
    rmdir "$candidate" 2>/dev/null && yellow "  removed stale external extension sync lock"
    return 0
  fi
  rmdir "$candidate" 2>/dev/null && yellow "  removed stale external extension sync lock"
}

_write_external_lock_owner() {
  local directory="$1" platform="$2" pid="$3" started="$4" token="$5"
  printf 'version=1\nplatform=%s\npid=%s\nprocess_started=%s\ntoken=%s\n' \
    "$platform" "$pid" "$started" "$token" > "$directory/owner"
}

acquire_external_extensions_lock() {
  local LC_ALL=C
  [[ "$EXT_LOCK_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] &&
    (( EXT_LOCK_TIMEOUT_SECONDS >= 1 && EXT_LOCK_TIMEOUT_SECONDS <= 300 )) ||
    { echo "COPILOT_EXTERNAL_EXTENSIONS_LOCK_TIMEOUT_SECONDS must be between 1 and 300" >&2; return 1; }

  if [[ -n "${COPILOT_EXTERNAL_EXTENSIONS_TEST_LOCK_ROOT_BARRIER:-}" ]]; then
    local barrier="${COPILOT_EXTERNAL_EXTENSIONS_TEST_LOCK_ROOT_BARRIER}"
    local marker="$barrier.bash.$$.$RANDOM"
    : > "$marker"
    local barrier_deadline=$((SECONDS + 10))
    while [[ ! -e "$barrier.release" ]]; do
      if (( SECONDS >= barrier_deadline )); then
        rm -f "$marker"
        echo "external extension test lock barrier timed out" >&2
        return 1
      fi
      sleep 0.05
    done
    rm -f "$marker"
  fi

  _ensure_cache_directory "$EXT_LOCK_ROOT" "$EXT_CACHE_ROOT" ||
    { echo "external extension lock root escapes its cache: $EXT_LOCK_ROOT" >&2; return 1; }

  local identity=()
  while IFS= read -r value; do identity+=("$value"); done < <(_external_lock_process_identity) || return 1
  (( ${#identity[@]} == 3 )) || return 1
  local platform="${identity[0]}" pid="${identity[1]}" started="${identity[2]}"
  EXT_LOCK_TOKEN=$(
    printf '%s' "$platform:$pid:$started:$RANDOM:$RANDOM:$(date +%s)" |
      git hash-object --stdin
  )
  local suffix="$platform--$pid--$started--$EXT_LOCK_TOKEN"
  local choosing="$EXT_LOCK_ROOT/choosing--$suffix"
  mkdir "$choosing" ||
    { echo "could not create external extension sync lock candidate" >&2; return 1; }
  EXT_LOCK_CHOOSING="$choosing"
  if ! _write_external_lock_owner "$choosing" "$platform" "$pid" "$started" "$EXT_LOCK_TOKEN"; then
    release_external_extensions_lock
    return 1
  fi
  if [[ "${COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_LOCK_STAGE:-}" == after-choosing-owner ]]; then
    return 1
  fi

  local max_ticket=0 candidate name number
  for candidate in "$EXT_LOCK_ROOT"/ticket-*; do
    [[ -d "$candidate" ]] || continue
    name=$(basename "$candidate")
    if [[ "$name" =~ ^ticket-([0-9]{10})-- ]]; then
      number=$((10#${BASH_REMATCH[1]}))
      (( number > max_ticket )) && max_ticket=$number
    fi
  done
  number=$((max_ticket + 1))
  printf -v name 'ticket-%010d--%s' "$number" "$suffix"
  EXT_LOCK_TICKET="$EXT_LOCK_ROOT/$name"
  if ! mkdir "$EXT_LOCK_TICKET"; then
    release_external_extensions_lock
    echo "could not create external extension sync lock ticket" >&2
    return 1
  fi
  if [[ "${COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_LOCK_STAGE:-}" == after-ticket-directory ]]; then
    return 1
  fi
  if ! _write_external_lock_owner "$EXT_LOCK_TICKET" "$platform" "$pid" "$started" "$EXT_LOCK_TOKEN"; then
    release_external_extensions_lock
    return 1
  fi
  if [[ "${COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_LOCK_STAGE:-}" == after-ticket-owner ]]; then
    return 1
  fi
  rm "$choosing/owner"
  rmdir "$choosing"
  EXT_LOCK_CHOOSING=""

  local deadline=$((SECONDS + EXT_LOCK_TIMEOUT_SECONDS))
  while true; do
    for candidate in "$EXT_LOCK_ROOT"/choosing--* "$EXT_LOCK_ROOT"/ticket-*; do
      [[ -d "$candidate" ]] || continue
      _remove_external_lock_candidate_if_stale "$candidate"
    done

    local choosing_exists=0
    for candidate in "$EXT_LOCK_ROOT"/choosing--*; do
      [[ -d "$candidate" ]] || continue
      choosing_exists=1
      break
    done
    if (( !choosing_exists )); then
      local winner=""
      for candidate in "$EXT_LOCK_ROOT"/ticket-*; do
        [[ -d "$candidate" ]] || continue
        winner="$candidate"
        break
      done
      if [[ "$winner" == "$EXT_LOCK_TICKET" ]]; then
        return 0
      fi
    fi

    if (( SECONDS >= deadline )); then
      release_external_extensions_lock
      yellow "  external extension sync lock timed out after ${EXT_LOCK_TIMEOUT_SECONDS}s"
      return 1
    fi
    sleep 0.05
  done
}

release_external_extensions_lock() {
  local candidate owner_file
  for candidate in "$EXT_LOCK_TICKET" "$EXT_LOCK_CHOOSING"; do
    [[ -n "$candidate" && -d "$candidate" ]] || continue
    [[ "$(basename "$candidate")" == *"--$EXT_LOCK_TOKEN" ]] || continue
    owner_file="$candidate/owner"
    if [[ -f "$owner_file" ]]; then
      [[ "$(find "$candidate" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d '[:space:]')" == 1 ]] || continue
      rm "$owner_file"
    else
      [[ -z "$(find "$candidate" -mindepth 1 -maxdepth 1 -print -quit)" ]] || continue
    fi
    rmdir "$candidate"
  done
  EXT_LOCK_TICKET=""
  EXT_LOCK_CHOOSING=""
  EXT_LOCK_TOKEN=""
}

_materialize_external_extension() {
  local clone_dir="$1" commit="$2" subpath="$3" owner="$4" repo="$5" install_name="$6"
  local owner_root="$EXT_MATERIALIZED_ROOT/$owner"
  local repository_root="$owner_root/$repo"
  local target="$repository_root/$install_name"

  _ensure_cache_directory "$EXT_MATERIALIZED_ROOT" "$EXT_CACHE_ROOT" ||
    { echo "external extension materialized root escapes its cache: $EXT_MATERIALIZED_ROOT" >&2; return 1; }
  _ensure_cache_directory "$owner_root" "$EXT_MATERIALIZED_ROOT" ||
    { echo "external extension owner tree escapes its cache: $owner_root" >&2; return 1; }
  _ensure_cache_directory "$repository_root" "$owner_root" ||
    { echo "external extension repository tree escapes its cache: $repository_root" >&2; return 1; }

  local temporary archive backup archive_tree
  backup="$repository_root/.${install_name}.backup"
  archive_tree="$commit"
  [[ "$subpath" != "." ]] && archive_tree="$commit:$subpath"

  if [[ ! -e "$target" && -e "$backup" ]]; then
    mv "$backup" "$target" || return 2
  elif [[ -e "$target" && -e "$backup" ]]; then
    rm -rf "$backup" || return 2
  fi

  if [[ "$subpath" == "." ]]; then
    git -C "$clone_dir" cat-file -e "$commit^{commit}" 2>/dev/null || return 1
  elif [[ "$(git -C "$clone_dir" cat-file -t "$archive_tree" 2>/dev/null)" != tree ]]; then
    return 1
  fi
  temporary=$(mktemp -d "$repository_root/.${install_name}.tmp.XXXXXX") || return 2
  archive=$(mktemp "$repository_root/.${install_name}.archive.tar.XXXXXX") ||
    { rm -rf "$temporary"; return 2; }

  local materialize_status
  (
    set -e
    installed_new_target=0
    transaction_committed=0
    restore_previous_tree() {
      local status=$?
      rm -rf "$temporary"
      rm -f "$archive"
      if (( !transaction_committed )); then
        if (( installed_new_target )) && [[ -e "$target" ]]; then
          rm -rf "$target"
        fi
        if [[ -e "$backup" ]]; then
          mv "$backup" "$target"
        fi
      fi
      trap - EXIT
      exit "$status"
    }
    trap restore_previous_tree EXIT
    trap 'exit 130' HUP INT TERM

    if ! git -c core.autocrlf=false -c core.eol=lf -C "$clone_dir" \
      archive --format=tar --output="$archive" "$archive_tree" 2>/dev/null; then
      exit 2
    fi
    if ! tar -xf "$archive" -C "$temporary"; then
      exit 2
    fi
    if [[ ! -f "$temporary/extension.mjs" ]]; then
      exit 1
    fi

    if [[ -e "$target" ]]; then
      mv "$target" "$backup" || exit 2
    fi
    mv "$temporary" "$target" || exit 2
    installed_new_target=1
    if [[ "${COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_AFTER_SWAP:-}" == 1 ]]; then
      exit 2
    fi
    [[ -f "$target/extension.mjs" ]] || exit 2
    [[ ! -e "$target/$(basename "$temporary")" ]] || exit 2
    transaction_committed=1
    if [[ "${COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_BACKUP_CLEANUP:-}" == 1 ]]; then
      exit 2
    fi
    rm -rf "$backup" || exit 2
    rm -f "$archive" || exit 2
    trap - EXIT HUP INT TERM
  ) || { materialize_status=$?; return "$materialize_status"; }

  printf '%s\n' "$target"
}

# Clone or fetch each external repository, materialize the selected commit
# through git archive, then link that immutable tree into Copilot. The clone's
# mutable working tree is never an installation source.
install_external_extensions() (
  [[ -f "$EXTERNAL_EXTENSIONS_FILE" ]] || return 0
  mkdir -p "$EXT_CACHE_ROOT"
  trap release_external_extensions_lock EXIT
  trap 'exit 130' HUP INT TERM
  acquire_external_extensions_lock || return 1
  if [[ -n "${COPILOT_EXTERNAL_EXTENSIONS_TEST_HOLD_LOCK_SECONDS:-}" ]]; then
    sleep "$COPILOT_EXTERNAL_EXTENSIONS_TEST_HOLD_LOCK_SECONDS"
  fi

  local dst_root="$COPILOT_HOME/$EXTENSIONS_DIR_NAME"
  mkdir -p "$dst_root"

  local kept_installs=()
  local kept_clones=()

  while IFS= read -r line || [[ -n "$line" ]]; do
    # Strip comments and trim whitespace.
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue

    # Tokenize on whitespace: spec [subpath] [install-name]
    # shellcheck disable=SC2206
    local tokens=($line)
    local spec="${tokens[0]}"
    local subpath="${tokens[1]:-.}"
    local install_name="${tokens[2]:-}"

    local ref=""
    if [[ "$spec" == *@* ]]; then
      ref="${spec##*@}"
      spec="${spec%@*}"
    fi
    if [[ ! "$spec" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
      yellow "  skip external entry (expected owner/repo): $line"
      continue
    fi
    local owner="${spec%%/*}"
    local repo="${spec##*/}"
    [[ -z "$install_name" ]] && install_name="$repo"
    if [[ ! "$install_name" =~ ^[A-Za-z0-9_.-]+$ || "$install_name" == "." || "$install_name" == ".." ]]; then
      yellow "  skip external entry (invalid install name): $line"
      continue
    fi
    if [[ "$subpath" == /* || "$subpath" == *\\* || "$subpath" == ".." || "$subpath" == ../* || "$subpath" == */../* || "$subpath" == */.. ]]; then
      yellow "  skip external entry (invalid subpath): $line"
      continue
    fi

    kept_installs+=("$install_name")
    kept_clones+=("$owner/$repo")

    local owner_dir="$EXT_CACHE_ROOT/$owner"
    local clone_dir="$owner_dir/$repo"
    _ensure_cache_directory "$owner_dir" "$EXT_CACHE_ROOT" ||
      { echo "external extension owner cache escapes its root: $owner_dir" >&2; return 1; }
    if [[ -e "$clone_dir" || -L "$clone_dir" ]]; then
      _ensure_cache_directory "$clone_dir" "$owner_dir" ||
        { echo "external extension clone path escapes its cache: $clone_dir" >&2; return 1; }
    fi
    if [[ ! -d "$clone_dir/.git" ]]; then
      if ! gh repo clone "$owner/$repo" "$clone_dir" -- --quiet; then
        yellow "  skip $owner/$repo (clone failed)"
        continue
      fi
    else
      git -C "$clone_dir" fetch --quiet origin || yellow "  warn: $owner/$repo fetch failed"
    fi

    local commit
    if ! commit=$(_resolve_external_commit "$clone_dir" "$ref"); then
      yellow "  skip $owner/$repo${ref:+@$ref} (commit not found)"
      continue
    fi

    local src materialize_status
    if src=$(_materialize_external_extension "$clone_dir" "$commit" "$subpath" "$owner" "$repo" "$install_name"); then
      :
    else
      materialize_status=$?
      if (( materialize_status == 1 )); then
        yellow "  skip $owner/$repo (no extension.mjs at ${subpath})"
        continue
      fi
      return "$materialize_status"
    fi

    _link_tree_into_extensions_dir "$src" "$dst_root/$install_name" "$EXT_MATERIALIZED_ROOT/" "extensions/$install_name (external: $owner/$repo@$commit)"
  done < "$EXTERNAL_EXTENSIONS_FILE"

  # Prune installs whose links point into $EXT_CACHE_ROOT but are no longer listed.
  local install_keep_list=""
  if (( ${#kept_installs[@]} > 0 )); then
    install_keep_list=$(printf '%s\n' "${kept_installs[@]}")
  fi
  _prune_managed_extension_dirs "$dst_root" "$EXT_CACHE_ROOT/" "$install_keep_list" "extensions (external)"

  # Prune cache dirs for repos no longer in the manifest.
  local clone_keep_list=""
  if (( ${#kept_clones[@]} > 0 )); then
    clone_keep_list=$(printf '%s\n' "${kept_clones[@]}")
  fi
  for owner_dir in "$EXT_CACHE_ROOT"/*; do
    [[ -d "$owner_dir" && ! -L "$owner_dir" ]] || continue
    local owner
    owner=$(basename "$owner_dir")
    for repo_dir in "$owner_dir"/*; do
      [[ -d "$repo_dir" && ! -L "$repo_dir" ]] || continue
      local repo
      repo=$(basename "$repo_dir")
      grep -qxF "$owner/$repo" <<< "$clone_keep_list" && continue
      rm -rf "$repo_dir"
      yellow "  removed cache $owner/$repo"
    done
    rmdir "$owner_dir" 2>/dev/null || true
  done
)

cmd_import() {
  echo "Importing copilot config: $COPILOT_HOME → $COPILOT_REPO"
  local files
  files=$(expand_globs "$COPILOT_HOME" "${PORTABLE_GLOBS[@]}")

  while IFS= read -r rel; do
    [[ -z "$rel" ]] && continue
    case "$rel" in
      skills/blackbird/SKILL.md|skills/blackbird-fileset/SKILL.md)
        yellow "  skip $rel (installed by gh blackbird)"
        continue
        ;;
    esac

    local src="$COPILOT_HOME/$rel"
    local dst="$COPILOT_REPO/$rel"

    # Skip anything whose real path lives outside ~/.copilot — it's managed
    # from another repo (dotfiles itself, or a private source like notes).
    # Resolving the full path rather than testing `-L "$src"` catches skills
    # symlinked at the directory level, where the SKILL.md is not itself a link.
    local real_src
    real_src="$(resolve_path "$src")"
    if [[ "$rel" == "copilot-instructions.md" && "$real_src" == "$COPILOT_HOME/.dotfiles/"* ]]; then
      yellow "  skip copilot-instructions.md (generated by configure-blackbird)"
      continue
    fi

    if [[ "$real_src" != "$COPILOT_HOME"/* ]]; then
      if [[ "$real_src" == "$COPILOT_REPO"/* ]]; then
        yellow "  skip $rel (already linked)"
      else
        yellow "  skip $rel (external source: $real_src)"
      fi
      continue
    fi

    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
    ln -sf "$dst" "$src"
    green "  imported $rel"
  done <<< "$files"
}

case "${1:-}" in
  install) cmd_install ;;
  import)  cmd_import ;;
  *)
    echo "Usage: script/sync-copilot {install|import}"
    exit 1
    ;;
esac
