#!/bin/bash

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TEST_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/sync-copilot-extensions.XXXXXX")
trap 'rm -rf "$TEST_ROOT"' EXIT

FIXTURE_REPOSITORY="$TEST_ROOT/repository"
MANIFEST="$TEST_ROOT/external-extensions"
FAKE_BIN="$TEST_ROOT/bin"
HOME_ROOT="$TEST_ROOT/home"
DATA_ROOT="$TEST_ROOT/data"
PROJECTS_ROOT="$TEST_ROOT/projects"
mkdir -p "$FIXTURE_REPOSITORY/extensions/sample/lib" "$FAKE_BIN" "$HOME_ROOT" "$DATA_ROOT" "$PROJECTS_ROOT"

cat > "$FIXTURE_REPOSITORY/extensions/sample/extension.mjs" <<'EOF'
export const fixture = "pinned";
EOF
printf 'nested fixture\n' > "$FIXTURE_REPOSITORY/extensions/sample/lib/value.txt"
git -C "$FIXTURE_REPOSITORY" init --quiet --initial-branch=main
git -C "$FIXTURE_REPOSITORY" config user.name "Fixture"
git -C "$FIXTURE_REPOSITORY" config user.email "fixture@example.com"
git -C "$FIXTURE_REPOSITORY" config core.autocrlf false
git -C "$FIXTURE_REPOSITORY" add .
LINK_BLOB=$(printf 'lib/value.txt' | git -C "$FIXTURE_REPOSITORY" hash-object -w --stdin)
git -C "$FIXTURE_REPOSITORY" update-index \
  --add --cacheinfo "120000,$LINK_BLOB,extensions/sample/link.txt"
git -C "$FIXTURE_REPOSITORY" commit --quiet -m "Add fixture extension"
COMMIT=$(git -C "$FIXTURE_REPOSITORY" rev-parse HEAD)

create_archive_safety_commit() {
  git -C "$FIXTURE_REPOSITORY" read-tree "$COMMIT"
  local name path target blob
  for name in absolute dotdot multihop dangling cycle directory; do
    blob=$(printf 'export const fixture = "%s";\n' "$name" |
      git -C "$FIXTURE_REPOSITORY" hash-object -w --stdin)
    git -C "$FIXTURE_REPOSITORY" update-index \
      --add --cacheinfo "100644,$blob,extensions/$name/extension.mjs"
  done
  blob=$(printf 'import "./module.mjs";\nexport const fixture = "valid";\n' |
    git -C "$FIXTURE_REPOSITORY" hash-object -w --stdin)
  git -C "$FIXTURE_REPOSITORY" update-index \
    --add --cacheinfo "100644,$blob,extensions/valid/extension.mjs"
  blob=$(printf 'export const dependency = "internal";\n' |
    git -C "$FIXTURE_REPOSITORY" hash-object -w --stdin)
  git -C "$FIXTURE_REPOSITORY" update-index \
    --add --cacheinfo "100644,$blob,extensions/valid/lib/module.mjs"
  while (( $# > 0 )); do
    path="$1"
    target="$2"
    shift 2
    blob=$(printf '%s' "$target" | git -C "$FIXTURE_REPOSITORY" hash-object -w --stdin)
    git -C "$FIXTURE_REPOSITORY" update-index --add --cacheinfo "120000,$blob,$path"
  done
  local tree commit
  tree=$(git -C "$FIXTURE_REPOSITORY" write-tree)
  commit=$(printf 'Add archive safety fixtures\n' |
    git -C "$FIXTURE_REPOSITORY" commit-tree "$tree" -p "$COMMIT")
  git -C "$FIXTURE_REPOSITORY" update-ref refs/heads/archive-safety "$commit"
  printf '%s\n' "$commit"
}

ARCHIVE_SAFETY_COMMIT=$(create_archive_safety_commit \
  extensions/absolute/absolute.txt /outside \
  extensions/dotdot/escape.txt ../outside \
  extensions/multihop/hop-a lib/hop-b \
  extensions/multihop/lib/hop-b ../../outside \
  extensions/dangling/dangling.txt missing.txt \
  extensions/cycle/cycle-a cycle-b \
  extensions/cycle/cycle-b cycle-a \
  extensions/entrypoint/extension.mjs ../outside.mjs \
  extensions/directory/assets ../outside-dir \
  extensions/valid/module.mjs lib/module.mjs)

cat > "$FAKE_BIN/gh" <<'EOF'
#!/bin/bash
if [[ "$1" == "repo" && "$2" == "clone" ]]; then
  sleep "${SYNC_TEST_CLONE_DELAY_SECONDS:-0}"
  git clone --quiet "$FIXTURE_REPOSITORY" "$4"
  exit
fi
exit 1
EOF
chmod +x "$FAKE_BIN/gh"

printf 'fixture/repo@%s  extensions/sample  sample\n' "$COMMIT" > "$MANIFEST"
run_sync_for() {
  local home_root="$1" data_root="$2" projects_root="$3"
  PATH="$FAKE_BIN:$PATH" \
    FIXTURE_REPOSITORY="$FIXTURE_REPOSITORY" \
    HOME="$home_root" \
    XDG_DATA_HOME="$data_root" \
    PROJECTS="$projects_root" \
    EXTERNAL_EXTENSIONS_FILE="$MANIFEST" \
    COPILOT_EXTERNAL_EXTENSIONS_LOCK_TIMEOUT_SECONDS="${COPILOT_EXTERNAL_EXTENSIONS_LOCK_TIMEOUT_SECONDS:-}" \
    COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_BACKUP_CLEANUP="${COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_BACKUP_CLEANUP:-}" \
    COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_LOCK_STAGE="${COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_LOCK_STAGE:-}" \
    COPILOT_EXTERNAL_EXTENSIONS_TEST_OWNER_STATUS="${COPILOT_EXTERNAL_EXTENSIONS_TEST_OWNER_STATUS:-}" \
    COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_AFTER_SWAP="${COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_AFTER_SWAP:-}" \
    COPILOT_EXTERNAL_EXTENSIONS_TEST_HOLD_LOCK_SECONDS="${COPILOT_EXTERNAL_EXTENSIONS_TEST_HOLD_LOCK_SECONDS:-}" \
    COPILOT_EXTERNAL_EXTENSIONS_TEST_LOCK_ROOT_BARRIER="${COPILOT_EXTERNAL_EXTENSIONS_TEST_LOCK_ROOT_BARRIER:-}" \
    SYNC_TEST_CLONE_DELAY_SECONDS="${SYNC_TEST_CLONE_DELAY_SECONDS:-}" \
    MSYS=winsymlinks:nativestrict \
    bash "$DOTFILES_ROOT/script/sync-copilot" install
}
run_sync() {
  run_sync_for "$HOME_ROOT" "$DATA_ROOT" "$PROJECTS_ROOT"
}

assert_installed_tree() {
  local expected="$1" installed="$2"
  local expected_files installed_files
  expected_files=$(cd "$expected" && find -L . -type f -print | sort)
  installed_files=$(cd "$installed" && find -L . -type f -print | sort)
  [[ "$expected_files" == "$installed_files" ]]
  while IFS= read -r relative; do
    [[ -z "$relative" ]] && continue
    if ! cmp "$expected/$relative" "$installed/$relative"; then
      od -An -tx1 "$expected/$relative"
      od -An -tx1 "$installed/$relative"
      return 1
    fi
  done <<< "$expected_files"
}

run_sync

CLONE="$DATA_ROOT/copilot-external-extensions/fixture/repo"
INSTALLED="$HOME_ROOT/.copilot/extensions/sample"
printf 'dirty tracked checkout\n' > "$CLONE/extensions/sample/extension.mjs"
printf 'dirty untracked checkout\n' > "$CLONE/extensions/sample/drift.txt"

run_sync

EXPECTED="$TEST_ROOT/expected"
ARCHIVE="$TEST_ROOT/expected.tar"
mkdir -p "$EXPECTED"
git -C "$FIXTURE_REPOSITORY" archive --format=tar --output="$ARCHIVE" "$COMMIT:extensions/sample"
tar -xf "$ARCHIVE" -C "$EXPECTED"
assert_installed_tree "$EXPECTED" "$INSTALLED"
[[ ! -e "$INSTALLED/drift.txt" ]]

MATERIALIZED="$DATA_ROOT/copilot-external-extensions/.materialized/fixture/repo/sample"
[[ -L "$MATERIALIZED/link.txt" ]]
{
  printf 'fixture/repo@%s  extensions/sample  sample\n' "$COMMIT"
  printf 'fixture/repo@%s  extensions/valid  valid-links\n' "$ARCHIVE_SAFETY_COMMIT"
  for name in absolute dotdot multihop dangling cycle entrypoint directory; do
    printf 'fixture/repo@%s  extensions/%s  rejected-%s\n' \
      "$ARCHIVE_SAFETY_COMMIT" "$name" "$name"
  done
} > "$MANIFEST"
run_sync > "$TEST_ROOT/rejected-links.log" 2>&1 || true
assert_installed_tree "$EXPECTED" "$INSTALLED"
assert_installed_tree "$EXPECTED" "$MATERIALIZED"
VALID_EXPECTED="$TEST_ROOT/valid-expected"
VALID_ARCHIVE="$TEST_ROOT/valid-expected.tar"
mkdir -p "$VALID_EXPECTED"
git -C "$FIXTURE_REPOSITORY" archive --format=tar --output="$VALID_ARCHIVE" \
  "$ARCHIVE_SAFETY_COMMIT:extensions/valid"
tar -xf "$VALID_ARCHIVE" -C "$VALID_EXPECTED"
assert_installed_tree "$VALID_EXPECTED" "$HOME_ROOT/.copilot/extensions/valid-links"
for name in absolute dotdot multihop dangling cycle entrypoint directory; do
  [[ ! -e "$HOME_ROOT/.copilot/extensions/rejected-$name" ]]
  grep -q "extensions/$name" "$TEST_ROOT/rejected-links.log"
done
printf 'fixture/repo@%s  extensions/sample  sample\n' "$COMMIT" > "$MANIFEST"
run_sync >/dev/null
assert_installed_tree "$EXPECTED" "$INSTALLED"

mv "$MATERIALIZED" "${MATERIALIZED%/sample}/.sample.backup"
printf 'fixture/repo@%s  extensions/missing  sample\n' "$COMMIT" > "$MANIFEST"
run_sync
assert_installed_tree "$EXPECTED" "$INSTALLED"

printf 'fixture/repo@%s  extensions/sample  sample\n' "$COMMIT" > "$MANIFEST"
if COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_AFTER_SWAP=1 run_sync; then
  echo "injected swap failure unexpectedly succeeded" >&2
  exit 1
fi
assert_installed_tree "$EXPECTED" "$INSTALLED"
run_sync >/dev/null
assert_installed_tree "$EXPECTED" "$INSTALLED"

printf 'dirty materialized tree\n' > "$MATERIALIZED/extension.mjs"
if COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_BACKUP_CLEANUP=1 run_sync >/dev/null 2>&1; then
  echo "injected backup cleanup failure unexpectedly succeeded" >&2
  exit 1
fi
assert_installed_tree "$EXPECTED" "$INSTALLED"
[[ -d "${MATERIALIZED%/sample}/.sample.backup" ]]
run_sync >/dev/null
[[ ! -e "${MATERIALIZED%/sample}/.sample.backup" ]]

LOCK_ROOT="$HOME_ROOT/.copilot/.locks/external-extensions"
for stage in after-choosing-owner after-ticket-directory after-ticket-owner; do
  if COPILOT_EXTERNAL_EXTENSIONS_TEST_FAIL_LOCK_STAGE="$stage" run_sync >/dev/null 2>&1; then
    echo "injected lock acquisition failure unexpectedly succeeded: $stage" >&2
    exit 1
  fi
  if compgen -G "$LOCK_ROOT/choosing--*" >/dev/null ||
    compgen -G "$LOCK_ROOT/ticket-*" >/dev/null; then
    echo "lock acquisition failure left a candidate: $stage" >&2
    exit 1
  fi
done
run_sync >/dev/null

CONCURRENT_HOME="$TEST_ROOT/concurrent-home"
CONCURRENT_DATA="$TEST_ROOT/concurrent-data"
CONCURRENT_PROJECTS="$TEST_ROOT/concurrent-projects"
mkdir -p "$CONCURRENT_HOME" "$CONCURRENT_DATA" "$CONCURRENT_PROJECTS"
FRESH_BARRIER="$TEST_ROOT/bash-fresh-lock"
COPILOT_EXTERNAL_EXTENSIONS_TEST_LOCK_ROOT_BARRIER="$FRESH_BARRIER" \
  SYNC_TEST_CLONE_DELAY_SECONDS=1 run_sync_for \
  "$CONCURRENT_HOME" "$CONCURRENT_DATA" "$CONCURRENT_PROJECTS" > "$TEST_ROOT/bash-1.log" 2>&1 &
BASH_ONE=$!
COPILOT_EXTERNAL_EXTENSIONS_TEST_LOCK_ROOT_BARRIER="$FRESH_BARRIER" \
  SYNC_TEST_CLONE_DELAY_SECONDS=1 run_sync_for \
  "$CONCURRENT_HOME" "$CONCURRENT_DATA" "$CONCURRENT_PROJECTS" > "$TEST_ROOT/bash-2.log" 2>&1 &
BASH_TWO=$!
for _ in {1..200}; do
  READY_COUNT=$(find "$TEST_ROOT" -maxdepth 1 -type f -name 'bash-fresh-lock.*' ! -name '*.release' | wc -l | tr -d '[:space:]')
  [[ "$READY_COUNT" == 2 ]] && break
  sleep 0.05
done
[[ "$READY_COUNT" == 2 ]]
: > "$FRESH_BARRIER.release"
wait "$BASH_ONE"
wait "$BASH_TWO"
CONCURRENT_INSTALLED="$CONCURRENT_HOME/.copilot/extensions/sample"
assert_installed_tree "$EXPECTED" "$CONCURRENT_INSTALLED"

CONCURRENT_CLONE="$CONCURRENT_DATA/copilot-external-extensions/fixture/repo"
printf 'dirty tracked checkout\n' > "$CONCURRENT_CLONE/extensions/sample/extension.mjs"
printf 'dirty untracked checkout\n' > "$CONCURRENT_CLONE/extensions/sample/drift.txt"
COPILOT_EXTERNAL_EXTENSIONS_TEST_HOLD_LOCK_SECONDS=0.5 run_sync_for \
  "$CONCURRENT_HOME" "$CONCURRENT_DATA" "$CONCURRENT_PROJECTS" > "$TEST_ROOT/bash-dirty-1.log" 2>&1 &
BASH_ONE=$!
run_sync_for \
  "$CONCURRENT_HOME" "$CONCURRENT_DATA" "$CONCURRENT_PROJECTS" > "$TEST_ROOT/bash-dirty-2.log" 2>&1 &
BASH_TWO=$!
wait "$BASH_ONE"
wait "$BASH_TWO"
assert_installed_tree "$EXPECTED" "$CONCURRENT_INSTALLED"
[[ ! -e "$CONCURRENT_INSTALLED/drift.txt" ]]

LOCK_ROOT="$CONCURRENT_HOME/.copilot/.locks/external-extensions"
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) STALE_PLATFORM=windows ;;
  *) STALE_PLATFORM=unix ;;
esac
STALE_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
STALE="$LOCK_ROOT/ticket-0000000001--$STALE_PLATFORM--2147483000--1--$STALE_TOKEN"
mkdir -p "$STALE"
printf 'version=1\nplatform=%s\npid=2147483000\nprocess_started=1\ntoken=%s\n' \
  "$STALE_PLATFORM" "$STALE_TOKEN" > "$STALE/owner"
STALE_BARRIER="$TEST_ROOT/bash-stale-lock"
COPILOT_EXTERNAL_EXTENSIONS_TEST_LOCK_ROOT_BARRIER="$STALE_BARRIER" \
  run_sync_for "$CONCURRENT_HOME" "$CONCURRENT_DATA" "$CONCURRENT_PROJECTS" > "$TEST_ROOT/bash-stale-1.log" 2>&1 &
BASH_ONE=$!
COPILOT_EXTERNAL_EXTENSIONS_TEST_LOCK_ROOT_BARRIER="$STALE_BARRIER" \
  run_sync_for "$CONCURRENT_HOME" "$CONCURRENT_DATA" "$CONCURRENT_PROJECTS" > "$TEST_ROOT/bash-stale-2.log" 2>&1 &
BASH_TWO=$!
for _ in {1..200}; do
  READY_COUNT=$(find "$TEST_ROOT" -maxdepth 1 -type f -name 'bash-stale-lock.*' ! -name '*.release' | wc -l | tr -d '[:space:]')
  [[ "$READY_COUNT" == 2 ]] && break
  sleep 0.05
done
[[ "$READY_COUNT" == 2 ]]
: > "$STALE_BARRIER.release"
wait "$BASH_ONE"
wait "$BASH_TWO"
[[ ! -e "$STALE" ]]

PARTIAL_TOKEN=dddddddddddddddddddddddddddddddddddddddd
PARTIAL="$LOCK_ROOT/choosing--$STALE_PLATFORM--2147483000--1--$PARTIAL_TOKEN"
mkdir "$PARTIAL"
printf 'version=1\n' > "$PARTIAL/owner"
run_sync_for "$CONCURRENT_HOME" "$CONCURRENT_DATA" "$CONCURRENT_PROJECTS" >/dev/null
[[ ! -e "$PARTIAL" ]]

UNKNOWN_TOKEN=cccccccccccccccccccccccccccccccccccccccc
UNKNOWN="$LOCK_ROOT/ticket-0000000001--$STALE_PLATFORM--2147483000--1--$UNKNOWN_TOKEN"
mkdir "$UNKNOWN"
printf 'version=1\nplatform=%s\npid=2147483000\nprocess_started=1\ntoken=%s\n' \
  "$STALE_PLATFORM" "$UNKNOWN_TOKEN" > "$UNKNOWN/owner"
if COPILOT_EXTERNAL_EXTENSIONS_TEST_OWNER_STATUS=unknown \
  COPILOT_EXTERNAL_EXTENSIONS_LOCK_TIMEOUT_SECONDS=1 \
  run_sync_for "$CONCURRENT_HOME" "$CONCURRENT_DATA" "$CONCURRENT_PROJECTS" \
    > "$TEST_ROOT/bash-unknown.log" 2>&1; then
  echo "unknown lock owner was incorrectly reclaimed" >&2
  exit 1
fi
[[ -d "$UNKNOWN" ]]
rm "$UNKNOWN/owner"
rmdir "$UNKNOWN"

COPILOT_EXTERNAL_EXTENSIONS_TEST_HOLD_LOCK_SECONDS=10 run_sync_for \
  "$CONCURRENT_HOME" "$CONCURRENT_DATA" "$CONCURRENT_PROJECTS" > "$TEST_ROOT/bash-holder.log" 2>&1 &
BASH_HOLDER=$!
for _ in {1..100}; do
  compgen -G "$LOCK_ROOT/ticket-*" >/dev/null && break
  sleep 0.05
done
compgen -G "$LOCK_ROOT/ticket-*" >/dev/null
if COPILOT_EXTERNAL_EXTENSIONS_LOCK_TIMEOUT_SECONDS=1 run_sync_for \
  "$CONCURRENT_HOME" "$CONCURRENT_DATA" "$CONCURRENT_PROJECTS" > "$TEST_ROOT/bash-timeout.log" 2>&1; then
  cat "$TEST_ROOT/bash-holder.log" >&2
  cat "$TEST_ROOT/bash-timeout.log" >&2
  echo "live lock contender unexpectedly succeeded" >&2
  exit 1
fi
grep -q "external extension sync lock timed out" "$TEST_ROOT/bash-timeout.log"
kill -0 "$BASH_HOLDER"
wait "$BASH_HOLDER"
assert_installed_tree "$EXPECTED" "$CONCURRENT_INSTALLED"
if compgen -G "$LOCK_ROOT/choosing--*" >/dev/null ||
  compgen -G "$LOCK_ROOT/ticket-*" >/dev/null; then
  echo "external extension lock candidates remain" >&2
  exit 1
fi
if find "$CONCURRENT_DATA/copilot-external-extensions/.materialized" \
  \( -name '*.tmp.*' -o -name '*.backup' \) -print -quit | grep -q .; then
  echo "external extension staging remnants remain" >&2
  exit 1
fi

echo "Bash external extension cache tests passed"
